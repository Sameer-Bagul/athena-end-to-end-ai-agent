{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "athena",
  "version": "1.0.0",
  "identifier": "com.athena.assistant",
  "build": {
    "frontendDist": "../renderer/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix renderer run dev",
    "beforeBuildCommand": "npm --prefix renderer run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Athena - 3D VRM AI Assistant",
        "width": 1920,
        "height": 1080,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0b0b0b"
      },
      {
        "label": "widget",
        "title": "Athena Widget",
        "url": "/#widget",
        "width": 300,
        "height": 300,
        "minWidth": 200,
        "minHeight": 200,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
