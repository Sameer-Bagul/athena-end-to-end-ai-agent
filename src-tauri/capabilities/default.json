{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Enables default permissions for Athena main and widget windows",
  "windows": [
    "main",
    "widget"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "global-shortcut:default"
  ]
}
