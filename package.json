{
  "name": "athena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "tauri": "npx @tauri-apps/cli",
    "tauri:dev": "npx @tauri-apps/cli dev",
    "tauri:build": "npx @tauri-apps/cli build",
    "dev": "npm run tauri:dev",
    "build": "npm run build:ui && npm run tauri:build",
    "build:ui": "cd renderer && npm run build",
    "build:sdk": "pnpm --filter @athena-ai/core build && pnpm --filter @athena-ai/react build && pnpm --filter @athena-ai/web build",
    "start": "npm run tauri:dev"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  }
}
